{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}Dashboard{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="card-title">{{ pendingPosts }}</h4>
                            <p class="card-text">Pending Posts</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-clock fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="card-title">{{ approvedPosts }}</h4>
                            <p class="card-text">Approved Posts</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="card-title">{{ rejectedPosts }}</h4>
                            <p class="card-text">Rejected Posts</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-times-circle fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="card-title">{{ totalPosts }}</h4>
                            <p class="card-text">Total Posts</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-newspaper fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if recentPendingPosts is not empty %}
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Recent Pending Posts</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Author</th>
                                    <th>Created</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for post in recentPendingPosts %}
                                    <tr>
                                        <td>
                                            <strong>{{ post.title }}</strong>
                                            <br>
                                            <small class="text-muted">
                                                {{ post.content|slice(0, 100) }}{% if post.content|length > 100 %}...{% endif %}
                                            </small>
                                        </td>
                                        <td>{{ post.author.email }}</td>
                                        <td>{{ post.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
