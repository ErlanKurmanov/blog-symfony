{% extends 'base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-3 text-center">
                                {% if user.profileImage %}
                                    <img src="{{ '/images/profiles/' ~ user.profileImage }}"
                                         alt="Profile Image"
                                         class="rounded-circle img-fluid"
                                         style="width: 150px; height: 150px; object-fit: cover;">
                                {% else %}
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center"
                                         style="width: 150px; height: 150px; margin: 0 auto;">
                                        <i class="bi bi-person-fill text-white" style="font-size: 3rem;"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="col-md-9">
                                <h1 class="card-title mb-3">
                                    {% if user.name or user.surname %}
                                        {{ user.name }} {{ user.surname }}
                                    {% else %}
                                        User Profile
                                    {% endif %}
                                </h1>
                                <p class="card-text">
                                    <strong>Email:</strong> {{ user.email }}<br>
                                    <strong>Status:</strong>
                                    {% if user.isVerified %}
                                        <span class="badge bg-success">Verified</span>
                                    {% else %}
                                        <span class="badge bg-warning">Not Verified</span>
                                    {% endif %}
                                </p>
                                <div class="d-flex gap-3 mb-3">
                                    <span><strong>{{ user.posts.count }}</strong> Posts</span>
                                    <span><strong>{{ user.followers.count }}</strong> Followers</span>
                                    <span><strong>{{ user.following.count }}</strong> Following</span>
                                </div>
                                <a href="{{ path('app_user_edit') }}" class="btn btn-primary">Edit Profile</a>
                            </div>
                        </div>
                    </div>
                </div>

                {% if user.following.count > 0 %}
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Following ({{ user.following.count }})</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                {% for followedUser in user.following %}
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex align-items-center justify-content-between p-3 border rounded">
                                            <div class="d-flex align-items-center">
                                                {% if followedUser.profileImage %}
                                                    <img src="{{ '/images/profile_images/' ~ followedUser.profileImage }}"
                                                         alt="Profile"
                                                         class="rounded-circle me-3"
                                                         style="width: 50px; height: 50px; object-fit: cover;">
                                                {% else %}
                                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3"
                                                         style="width: 50px; height: 50px;">
                                                        <i class="bi bi-person-fill text-white"></i>
                                                    </div>
                                                {% endif %}
                                                <div>
                                                    <h6 class="mb-0">
                                                        {% if followedUser.name or followedUser.surname %}
                                                            {{ followedUser.name }} {{ followedUser.surname }}
                                                        {% else %}
                                                            User
                                                        {% endif %}
                                                    </h6>
                                                    <small class="text-muted">{{ followedUser.email }}</small>
                                                </div>
                                            </div>
                                            <button class="btn btn-sm btn-warning follow-btn"
                                                    data-user-id="{{ followedUser.id }}"
                                                    data-following="true">
                                                Unfollow
                                            </button>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if user.followers.count > 0 %}
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Followers ({{ user.followers.count }})</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                {% for follower in user.followers %}
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex align-items-center justify-content-between p-3 border rounded">
                                            <div class="d-flex align-items-center">
                                                {% if follower.profileImage %}
                                                    <img src="{{ '/images/profile_images/' ~ follower.profileImage }}"
                                                         alt="Profile"
                                                         class="rounded-circle me-3"
                                                         style="width: 50px; height: 50px; object-fit: cover;">
                                                {% else %}
                                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3"
                                                         style="width: 50px; height: 50px;">
                                                        <i class="bi bi-person-fill text-white"></i>
                                                    </div>
                                                {% endif %}
                                                <div>
                                                    <h6 class="mb-0">
                                                        {% if follower.name or follower.surname %}
                                                            {{ follower.name }} {{ follower.surname }}
                                                        {% else %}
                                                            User
                                                        {% endif %}
                                                    </h6>
                                                    <small class="text-muted">{{ follower.email }}</small>
                                                </div>
                                            </div>
                                            {% if user.following.contains(follower) %}
                                                <button class="btn btn-sm btn-warning follow-btn"
                                                        data-user-id="{{ follower.id }}"
                                                        data-following="true">
                                                    Unfollow
                                                </button>
                                            {% else %}
                                                <button class="btn btn-sm btn-outline-primary follow-btn"
                                                        data-user-id="{{ follower.id }}"
                                                        data-following="false">
                                                    Follow Back
                                                </button>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if user.posts.count > 0 %}
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">My Recent Posts ({{ user.posts.count }})</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                {% for post in user.posts|slice(0, 6) %}
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100">
                                            {% if post.image %}
                                                <img src="{{ '/images/posts/' ~ post.image }}"
                                                     class="card-img-top"
                                                     alt="{{ post.title }}"
                                                     style="height: 150px; object-fit: cover;">
                                            {% endif %}
                                            <div class="card-body d-flex flex-column">
                                                <h6 class="card-title">{{ post.title }}</h6>
                                                <p class="card-text flex-grow-1">
                                                    {{ post.content|length > 100 ? post.content|slice(0, 100) ~ '...' : post.content }}
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                                    <small class="text-muted">{{ post.createdAt|date('M j, Y') }}</small>
                                                    <div>
                                                        <a href="{{ path('app_post_show', {'id': post.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
                                                        <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            {% if user.posts.count > 6 %}
                                <div class="text-center mt-3">
                                    <a href="{{ path('app_post_index') }}" class="btn btn-outline-primary">View All My Posts</a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="card">
                        <div class="card-body text-center">
                            <h5>No posts yet</h5>
                            <p class="text-muted">Start sharing your thoughts with the world!</p>
                            <a href="{{ path('app_post_new') }}" class="btn btn-primary">Create Your First Post</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
