{# templates/main/_post_chunk.html.twig #}
{% for post in posts %}
    <div class="card my-3 post-item"> {# Добавили класс post-item #}
        <div class="card-body">
            <h5 class="card-title">{{ post.title }}</h5>
            <h6 class="card-subtitle mb-2 text-muted">
                by {{ post.author.email }} on {{ post.createdAt|date('Y-m-d H:i') }}
            </h6>
            <p class="card-text">{{ post.content|slice(0, 200) }}...</p>
            <a href="{{ path('app_post_show', {'id': post.id}) }}" class="btn btn-primary">Read More</a>

            <div class="mt-2 d-flex align-items-center" data-post-id="{{ post.id }}">
                {# ... кнопки лайков ... #}
            </div>
        </div>
    </div>
{% endfor %}
